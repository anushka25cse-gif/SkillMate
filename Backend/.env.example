# ---------------------------------------------------------------------------
# SkillMate backend configuration
# Copy this file to `.env` and change the values for your machine.
# The server also works without a .env file by using the defaults below,
# EXCEPT in production where JWT_SECRET is mandatory.
# ---------------------------------------------------------------------------

# HTTP port
PORT=3000

# development | production
NODE_ENV=development

# JSON database folder (defaults to Backend/Data)
# SKILLMATE_DATA_DIR=./Data

# Secret used to sign JWT access tokens.
# Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# bcrypt cost factor (10 is a good default; higher is slower but stronger)
BCRYPT_ROUNDS=10

# Authentication rate limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Comma separated list of extra origins allowed to call the API.
# Leave empty when the pages are served by this same server.
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Serve the existing HTML/CSS/JS pages from the repository root
SERVE_FRONTEND=true
